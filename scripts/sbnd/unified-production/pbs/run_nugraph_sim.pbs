#!/bin/bash
#PBS -N nugraph_sim
#PBS -l select=1:ncpus=16
#PBS -l walltime=01:30:00
#PBS -l filesystems=home:eagle:grand
#PBS -q debug
#PBS -A neutrinoGPU::debug
#PBS -j oe
#PBS -o REPLACE_WITH_LOG_PATH

# PBS submission wrapper for --mode sim.
# Edit the variables below, then submit with:
#   qsub run_nugraph_sim.pbs
#
# Do NOT commit or push. Do NOT overwrite frozen reference H5 files.

set -uo pipefail

module load spack-pe-base
module load apptainer
echo "apptainer: $(apptainer version)"

DRIVER=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/bin/run_nugraph_production.sh

# ── Required: edit before submission ──────────────────────────────────────────
MANIFEST=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/work/haiwang-current/engineering-50evt-persistent/manifests/source_events_50evt.csv
OUTPUT_H5=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/sim_one_event/canonical/nugraph_sim_test.h5
OUTPUT_DIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/sim_one_event
REPORT=$OUTPUT_DIR/logs/receiver_report.json
# Receiver manifest: for sim, producer manifest == receiver manifest
RECEIVER_MANIFEST=$MANIFEST
# ──────────────────────────────────────────────────────────────────────────────

mkdir -p "$OUTPUT_DIR/logs"

echo "PBS Job ID: ${PBS_JOBID:-local}"
echo "Host: $(hostname)"
echo "Time: $(date)"

bash "$DRIVER" \
    --mode sim \
    --manifest "$MANIFEST" \
    --receiver-manifest "$RECEIVER_MANIFEST" \
    --output-h5 "$OUTPUT_H5" \
    --output-dir "$OUTPUT_DIR" \
    --report "$REPORT"

DRIVER_EXIT=$?
echo "Driver exit: $DRIVER_EXIT"
echo "Time: $(date)"
exit $DRIVER_EXIT
