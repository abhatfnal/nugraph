#!/bin/bash
#PBS -N nugraph_sim_1evt
#PBS -l select=1:ncpus=16
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle:grand
#PBS -q by-gpu
#PBS -A neutrinoGPU::wirecell_2026
#PBS -j oe
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/sim_one_event/logs/pbs_sim_one_event.log

# Sim one-event regression: RSE 1/2728/1 (source_index=0 from 50-event reference)
# Validates unified driver --mode sim against frozen reference H5.
# Do NOT overwrite engineering-sample-50evt-debug/canonical/haiwang-nugraph4-canonical-v1.h5

set -uo pipefail

module load spack-pe-base
module load apptainer
echo "apptainer: $(apptainer version)"

DRIVER=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/nugraph-sophia-dev/scripts/sbnd/unified-production/bin/run_nugraph_production.sh
MANIFEST=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/sim_one_event/sim_one_event_manifest.csv
OUTPUT_H5=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/sim_one_event/canonical/sim_one_event.h5
OUTPUT_DIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/sim_one_event
REPORT=$OUTPUT_DIR/logs/receiver_report.json

mkdir -p "$OUTPUT_DIR/logs" "$OUTPUT_DIR/canonical"

echo "PBS Job ID: ${PBS_JOBID:-local}"
echo "Host: $(hostname)"
echo "Time: $(date)"
echo "Sim one-event regression: RSE 1/2728/1  source_index=0"

bash "$DRIVER" \
    --mode sim \
    --manifest "$MANIFEST" \
    --receiver-manifest "$MANIFEST" \
    --output-h5 "$OUTPUT_H5" \
    --output-dir "$OUTPUT_DIR" \
    --report "$REPORT"

DRIVER_EXIT=$?
echo "Driver exit: $DRIVER_EXIT"
echo "Time: $(date)"
exit $DRIVER_EXIT
