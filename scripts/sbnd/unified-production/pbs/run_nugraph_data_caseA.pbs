#!/bin/bash
#PBS -N nugraph_data_caseA
#PBS -l select=1:ncpus=16
#PBS -l walltime=00:45:00
#PBS -l filesystems=home:eagle:grand
#PBS -q by-gpu
#PBS -A neutrinoGPU::wirecell_2026
#PBS -j oe
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/data_caseA/logs/pbs_data_caseA.log

# Case A regression: RSE 18255/1/114446, nskip=46, --mode data
# Validates unified driver data path against previously validated caseA H5.
# Do NOT overwrite one_event_smoke/canonical/caseA_18255_1_114446.h5.

set -uo pipefail

module load spack-pe-base
module load apptainer
echo "apptainer: $(apptainer version)"

DRIVER=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/nugraph-sophia-dev/scripts/sbnd/unified-production/bin/run_nugraph_production.sh
MANIFEST=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/engineering-nc-sideband-19evt-corrected/scripts/caseA_114446/caseA_114446_manifest.csv
OUTPUT_H5=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/data_caseA/canonical/data_caseA_18255_1_114446.h5
OUTPUT_DIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/unified-nugraph-production/tests/data_caseA
REPORT=$OUTPUT_DIR/logs/receiver_report.json

mkdir -p "$OUTPUT_DIR/logs"

echo "PBS Job ID: ${PBS_JOBID:-local}"
echo "Host: $(hostname)"
echo "Time: $(date)"
echo "Case A regression: RSE 18255/1/114446 nskip=46"

bash "$DRIVER" \
    --mode data \
    --manifest "$MANIFEST" \
    --receiver-manifest "$MANIFEST" \
    --output-h5 "$OUTPUT_H5" \
    --output-dir "$OUTPUT_DIR" \
    --report "$REPORT"

DRIVER_EXIT=$?
echo "Driver exit: $DRIVER_EXIT"
echo "Time: $(date)"
exit $DRIVER_EXIT
